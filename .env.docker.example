# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudflare_notify

# Backend Authentication & Encryption
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend Public API URL (accessible from browser on host port 15433)
NEXT_PUBLIC_API_URL=http://localhost:15433

# Optional Cloudflare Worker Proxy for Telegram (routes all Telegram traffic through worker)
TELEGRAM_PROXY_WORKER_URL=https://your-worker-subdomain.workers.dev
TELEGRAM_PROXY_SECRET=your_worker_api_secret_key
