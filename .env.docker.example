# ==============================================================================
# Cloudflare Notify - Production Environment Configuration (Coolify / Docker)
# ==============================================================================

# 1. PostgreSQL Database Connection (From Coolify PostgreSQL Service)
# Example internal connection: postgresql://postgres:password@<postgres-service-host>:5432/cf_notify?schema=public
# Example external connection: postgresql://postgres:password@your-vps-ip:5432/cf_notify?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudflare_notify?schema=public

# 2. Backend Security & JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d
# 32-byte hexadecimal AES encryption key for user tokens
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. Domain & Public Routing
# Allowed origin for CORS (Public URL of your frontend dashboard)
FRONTEND_URL=https://notify.yourdomain.com

# 4. Optional Cloudflare Worker Proxy for Telegram (System Proxy Fallback)
TELEGRAM_PROXY_WORKER_URL=https://your-worker-subdomain.workers.dev
TELEGRAM_PROXY_SECRET=your_worker_api_secret_key

# 5. System Onboarding Bot for Telegram OTP Verification
TELEGRAM_SYSTEM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_SYSTEM_BOT_USERNAME=your_onboarding_bot
TELEGRAM_ENABLE_POLLING=false
