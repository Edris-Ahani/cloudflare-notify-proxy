# SECURITY
# The API key required to send requests to your worker. 
# Clients must include it in the header: 'Authorization: Bearer YOUR_API_SECRET_KEY'
API_SECRET_KEY=your_super_secret_api_key_here

# TELEGRAM CONFIGURATION
# Your Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
# The default chat ID to send messages to
TELEGRAM_DEFAULT_CHAT_ID=-100123456789

# COOLIFY CONFIGURATION (Default)
# Used when calling /send/coolify
COOLIFY_WEBHOOK=https://coolify.yourdomain.com/api/v1/deploy?uuid=...
COOLIFY_TOKEN=your_coolify_token_here

# MULTIPLE COOLIFY PROJECTS (Dynamic Routing)
# Used when calling /send/coolify/<PROJECT_NAME>
# Below are 3 examples of how to define multiple projects:

# Example 1: Triggered via /send/coolify/frontend
# COOLIFY_WEBHOOK_URL_FRONTEND=https://coolify.yourdomain.com/api/v1/deploy?uuid=1111
# COOLIFY_TOKEN_FRONTEND=token_for_frontend

# Example 2: Triggered via /send/coolify/backend_api
# COOLIFY_WEBHOOK_URL_BACKEND_API=https://coolify.yourdomain.com/api/v1/deploy?uuid=2222
# COOLIFY_TOKEN_BACKEND_API=token_for_backend_api

# Example 3: Triggered via /send/coolify/database_prod
# COOLIFY_WEBHOOK_URL_DATABASE_PROD=https://coolify.yourdomain.com/api/v1/deploy?uuid=3333
# COOLIFY_TOKEN_DATABASE_PROD=token_for_database_prod

# GOOGLE AUTH (OAuth intermediary)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an Authorized redirect URI in Google Console exactly.
# Example local: http://127.0.0.1:8787/auth/google/callback
# Example prod:  https://cloudflare-notify.<YOUR_USERNAME>.workers.dev/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
# Used to sign session JWTs returned to your app after Google login.
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated list of allowed app origins for return_to.
# Example: http://localhost:3000,https://myapp.example.com
ALLOWED_RETURN_ORIGINS=http://localhost:3000
